{
  "name": "@diskette/dialtone",
  "version": "0.0.0",
  "files": [
    "binding.d.ts",
    "binding.js",
    "index.d.ts",
    "index.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --esm --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --esm --platform --js binding.js --dts binding.d.ts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "vitest run --typecheck",
    "typecheck": "tsc",
    "fmt:js": "oxfmt",
    "fmt:rs": "cargo fmt"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "napi": {
    "binaryName": "dialtone",
    "constEnum": false,
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "packageManager": "pnpm@11.5.2"
}
